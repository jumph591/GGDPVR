// GGDPVR Setup resources. The files are found through the include path (CMakeLists.txt): the build folder (the two
// DLLs), config\ (ggdpvr.ini) and package\setup_app\res\ (art).
#include <winver.h>
#include "resource_ids.h"

IDI_APP     ICON   "app.ico"
IDR_LOADER  RCDATA "dinput8.dll"
IDR_MOD     RCDATA "GGDPVR.dll"
IDR_INI     RCDATA "ggdpvr.ini"
IDR_LOGO    RCDATA "logo.png"

VS_VERSION_INFO VERSIONINFO
FILEVERSION GGDPVR_VER_COMMA
PRODUCTVERSION GGDPVR_VER_COMMA
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "GGDPVR Setup - VR mod for Gal*Gun: Double Peace"
            VALUE "FileVersion", GGDPVR_SETUP_VERSION
            VALUE "InternalName", "GGDPVR-Setup"
            VALUE "OriginalFilename", "GGDPVR-Setup.exe"
            VALUE "ProductName", "GGDPVR"
            VALUE "ProductVersion", GGDPVR_SETUP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
